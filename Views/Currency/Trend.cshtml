@model TrendViewModel
@{
    ViewData["Title"] = "Rate trend";
    string Fmt(decimal? v) => v is null ? "" : v.Value.ToString("N2");
    string Dt(DateOnly? d) => d is null ? "" : d.Value.ToString("dd MMM yyyy");
}

<div class="page-head">
    <h1>Rate trend</h1>
    <p>What would your money have been worth over time?</p>
</div>

<div class="stack">
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert error">@Model.ErrorMessage</div>
    }
    <div asp-validation-summary="ModelOnly" class="alert error"></div>

    <div class="card">
        <form asp-action="Trend" method="post">
            <div class="form-grid">
                <div class="field full">
                    <label class="label" for="Amount">Amount</label>
                    <input asp-for="Amount" type="number" step="any" inputmode="decimal" class="input" />
                    <span asp-validation-for="Amount" class="field-error"></span>
                </div>
                <div class="field">
                    <label class="label" for="FromCurrency">From</label>
                    <select asp-for="FromCurrency" class="select" asp-items="@(CurrencyOptions.Items)"></select>
                </div>
                <div class="field">
                    <label class="label" for="ToCurrency">To</label>
                    <select asp-for="ToCurrency" class="select" asp-items="@(CurrencyOptions.Items)"></select>
                    <span asp-validation-for="ToCurrency" class="field-error"></span>
                </div>
                <div class="field full">
                    <span class="label">Period</span>
                    <div class="segmented" role="radiogroup" aria-label="Period">
                        @foreach (var p in TrendViewModel.PeriodLabels)
                        {
                            <input type="radio" name="Period" id="period-@p.Key" value="@p.Key" checked="@(Model.Period == p.Key)" />
                            <label for="period-@p.Key">@p.Value</label>
                        }
                    </div>
                </div>
            </div>
            <div class="actions">
                <button type="submit" class="btn btn-primary">Show graph</button>
            </div>
        </form>
    </div>

    @if (Model.HasResult)
    {
        var up = Model.Change >= 0;
        var tone = up ? "up" : "down";

        <div class="card">
            <div class="card-head">
                <h2>@Model.FromCurrency &rarr; @Model.ToCurrency</h2>
                <span class="small muted num">@Fmt(Model.Amount) @Model.FromCurrency over @TrendViewModel.PeriodLabels[Model.Period]</span>
            </div>
            <div class="chart-box"><canvas id="trendChart"></canvas></div>
        </div>

        <div class="stats">
            <div class="stat">
                <div class="k">Starting value &middot; @Dt(Model.StartDate)</div>
                <div class="v">@Fmt(Model.StartValue) @Model.ToCurrency</div>
            </div>
            <div class="stat">
                <div class="k">Current value &middot; @Dt(Model.CurrentDate)</div>
                <div class="v">@Fmt(Model.CurrentValue) @Model.ToCurrency</div>
            </div>
            <div class="stat">
                <div class="k">Change</div>
                <div class="v @tone">@(up ? "▲" : "▼") @Fmt(Math.Abs(Model.Change!.Value)) @Model.ToCurrency</div>
                <div class="s @tone">@(up ? "+" : "")@Model.ChangePercent%</div>
            </div>
            <div class="stat">
                <div class="k">High &amp; low</div>
                <div class="v" style="font-size:1.1rem">High @Fmt(Model.HighValue)</div>
                <div class="s">@Dt(Model.HighDate)</div>
                <div class="v" style="font-size:1.1rem;margin-top:10px">Low @Fmt(Model.LowValue)</div>
                <div class="s">@Dt(Model.LowDate)</div>
            </div>
        </div>

        <p class="muted small">
            Each point is your @Fmt(Model.Amount) @Model.FromCurrency converted at that day's rate
            (weekly points for periods of a year or more). Past rates don't predict future ones.
        </p>
    }
</div>

@section Scripts {
    @if (Model.HasResult)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                const labels = @Json.Serialize(Model.Points.Select(p => p.Date.ToString("dd MMM yyyy")));
                const values = @Json.Serialize(Model.Points.Select(p => p.Value));
                const rates  = @Json.Serialize(Model.Points.Select(p => p.Rate));
                const cur = '@Model.ToCurrency';

                const css = getComputedStyle(document.documentElement);
                const accent = css.getPropertyValue('--accent').trim();
                const muted = css.getPropertyValue('--muted').trim();
                const grid = css.getPropertyValue('--border').trim();

                const ctx = document.getElementById('trendChart').getContext('2d');
                const fill = ctx.createLinearGradient(0, 0, 0, 340);
                fill.addColorStop(0, accent + '33');
                fill.addColorStop(1, accent + '00');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Value in ' + cur,
                            data: values,
                            borderColor: accent,
                            backgroundColor: fill,
                            borderWidth: 2.5,
                            fill: true,
                            tension: 0.3,
                            pointRadius: 0,
                            pointHoverRadius: 5,
                            pointHoverBackgroundColor: accent
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: c => c.parsed.y.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + cur,
                                    afterLabel: c => 'Rate: ' + rates[c.dataIndex]
                                }
                            }
                        },
                        scales: {
                            x: { grid: { display: false }, border: { display: false }, ticks: { color: muted, maxTicksLimit: 6, maxRotation: 0 } },
                            y: { grid: { color: grid }, border: { display: false }, ticks: { color: muted, callback: v => v.toLocaleString() } }
                        }
                    }
                });
            })();
        </script>
    }
}
