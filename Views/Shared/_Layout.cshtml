@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string a) => controller == "Currency" && action == a ? "active" : "";
    var email = User.Identity?.Name ?? "";
    var initial = email.Length > 0 ? email.Substring(0, 1).ToUpperInvariant() : "?";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CurrencyMini</title>
    <meta name="description" content="Convert currencies, plan travel budgets and explore exchange-rate trends." />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%231D1D1F' stroke='%23333' stroke-width='2'/%3E%3Cpath d='M9 12h13l-3-3M23 20H10l3 3' fill='none' stroke='white' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
    <script>
        (function() {
            var t = localStorage.getItem('theme');
            if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
        })();
    </script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            window.addEventListener("pageshow", function (event) {
                var nav = performance.getEntriesByType("navigation")[0];
                if (event.persisted || (nav && nav.type === "back_forward")) {
                    window.location.reload();
                }
            });
        </script>
    }
</head>
<body>
    <header class="site-header">
        <div class="wrap header-row">
            <a class="brand" asp-controller="Currency" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h14l-3.5-3.5M20 16H6l3.5 3.5" /></svg>
                </span>
                CurrencyMini
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="tabs" aria-label="Main">
                    <a class="@Active("Index")" asp-controller="Currency" asp-action="Index">Convert</a>
                    <a class="@Active("Travel")" asp-controller="Currency" asp-action="Travel">Travel Budget</a>
                    <a class="@Active("History")" asp-controller="Currency" asp-action="History">History</a>
                </nav>
            }

            <div class="header-right">
                <button id="themeToggle" class="btn btn-ghost btn-sm" aria-label="Toggle theme" style="width: 36px; padding: 0; display: flex; align-items: center; justify-content: center;">
                    <svg id="themeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <!-- Default icon, JS will switch it -->
                        <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                    </svg>
                </button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="avatar" title="@email">@initial</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                        <button type="submit" class="btn btn-ghost btn-sm">Log out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Sign up</a>
                }
            </div>
        </div>
    </header>

    <main>
        <div class="wrap">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer" style="padding: 40px 0; text-align: center; color: var(--text-secondary); font-size: 0.85rem;">
        <div class="wrap">Exchange rates provided by Frankfurter &middot; For information only, not financial advice.</div>
    </footer>

    <script src="~/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
